# Production environment variables.
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.

# Required
SESSION_SECRET=<generated-48-byte-base64>
OIDC_SIGNING_SECRET=<generated-48-byte-base64>
OIDC_ISSUER=https://portal.lgu.gov.ph

# PostgreSQL user store
DATABASE_URL=postgres://portal:<password>@db:5432/lgu_portal

# Redis session store
REDIS_URL=redis://redis:6379

# Optional external IdP
# IDP_ISSUER=https://keycloak.lgu.gov.ph
# IDP_CLIENT_ID=portal-client
# IDP_CLIENT_SECRET=<from-secret-manager>
# IDP_SCOPES=openid profile email

# Optional: disable local login when IdP is the only identity source
# LOCAL_LOGIN_ENABLED=false

# Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info
