# Production environment variables.
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.

# Required
SESSION_SECRET=<generated-48-byte-base64>
OIDC_SIGNING_SECRET=<generated-48-byte-base64>
OIDC_ISSUER=https://portal.lgu.gov.ph

# RS256 signing key (PEM). Must be identical on every replica: with it unset each
# pod generates its own key at boot, so /api/oidc/jwks publishes whichever pod
# answers and clients that cached the set reject valid tokens. Newlines are
# written as literal \n because a secretKeyRef cannot carry a multi-line value.
# Generate with: node scripts/gen-k8s-secret.mjs
# Rotating it means updating the secret and rolling the deployment; the in-app
# rotation button is disabled while this is set.
OIDC_SIGNING_PRIVATE_KEY=<pkcs8-pem-with-escaped-newlines>

# Every seeded demo account shares this password (src/lib/auth/users.ts throws
# at module load if it is unset, so /login returns 500 without it). Rejected by
# scripts/verify-deploy.mjs when set to a well-known value.
DEMO_PASSWORD=<set-me>

# PostgreSQL user store
DATABASE_URL=postgres://portal:<password>@db:5432/lgu_portal

# Redis session store
REDIS_URL=redis://redis:6379

# Optional external IdP
# IDP_ISSUER=https://keycloak.lgu.gov.ph
# IDP_CLIENT_ID=portal-client
# IDP_CLIENT_SECRET=<from-secret-manager>
# IDP_SCOPES=openid profile email

# Optional: disable local login when IdP is the only identity source
# LOCAL_LOGIN_ENABLED=false

# Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info
