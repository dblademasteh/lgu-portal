# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# REQUIRED in production. Signs session cookies and handoff tickets.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating this invalidates every active session and every pending sign-on
# handoff. There is no key ring, so plan a brief signed-out window.
SESSION_SECRET=

# Signs OIDC access and ID tokens. Defaults to SESSION_SECRET when unset, which
# is acceptable for a single-service deployment. Set it separately if the token
# signing key is rotated on a different schedule to the session key.
OIDC_SIGNING_SECRET=

# The public origin of this authorisation server. Must match the origin the
# browser actually uses, or redirect_uri validation will reject every request.
# In production set this to the real hostname, e.g. https://portal.lgu.gov.ph
OIDC_ISSUER=http://localhost:3000

# Redirect URI registered for the seed `lgu-hrms` OIDC client (HRMS as a
# relying party of this portal). Set this to your HRMS instance's OIDC callback.
# Comma-separated list allowed. Required only when HRMS consumes SSO from here.
HRMS_REDIRECT_URI=http://localhost:4000/api/oidc/callback

# Demo password shared by every seeded account. Development only — the seeded
# directory is itself a stub. See README "Wiring a real IdP".
DEMO_PASSWORD=Lgu@Portal2026

# ---------------------------------------------------------------------------
# Session store backend
# ---------------------------------------------------------------------------
# Leave REDIS_URL unset and sessions are kept in an in-process Map: a restart
# signs everyone out, and a second replica cannot see existing sessions, so load
# balancing needs sticky sessions. That is fine for development and wrong for
# production.
#
# Set REDIS_URL and the portal keeps sessions in Redis instead: they survive
# restarts and are shared across replicas. If Redis is unreachable the app logs
# the failure and degrades to the in-memory store rather than erroring, and
# /api/health/readiness reports "degraded" so the condition is visible.
#
#   docker compose up redis        # local
#   REDIS_URL=redis://redis:6379   # in-cluster (set in k8s/configmap.yaml)
#
# Note that this covers *sessions* only. OIDC authorization codes, refresh
# tokens, and pending flows are still in-process Maps, so the portal is not yet
# correct on more than one replica. See README "Limitations".
REDIS_URL=

# Optional explicit backend pin, which overrides the REDIS_URL heuristic:
#   SESSION_STORE=memory  force in-process sessions even if REDIS_URL is set
#   SESSION_STORE=redis   force Redis, ignoring whether REDIS_URL is set
# Neither value makes the app hard-fail when Redis is down. If Redis is
# unreachable the session store degrades to non-durable in-memory sessions,
# reports `degraded` on /api/health/readiness, and retries Redis on a backoff
# (2s doubling to 30s) until it recovers. Sessions created in memory during an
# outage are not migrated, so those users sign in again. Alert on a readiness
# status of `degraded` rather than expecting a 503.
SESSION_STORE=

# ---------------------------------------------------------------------------
# Persistent user store (PostgreSQL) — optional
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset and the portal uses the in-memory seeded directory.
# Set DATABASE_URL and the portal stores users in PostgreSQL instead. When the
# database is unreachable the portal falls back to the stub directory so it
# keeps working.
#
# Migrations run automatically on startup. Run them manually with:
#   npm run db:migrate
#
# Example:
#   DATABASE_URL=postgres://portal:secret@db:5432/lgu_portal
DATABASE_URL=

# ---------------------------------------------------------------------------
# External Identity Provider (IdP) — optional
# ---------------------------------------------------------------------------
# When IDP_ISSUER is set, the portal adds an OIDC-based "Sign in with IdP"
# button on the login page and delegates authentication to that provider.
# The local stub directory remains available when IDP_ISSUER is unset.
#
# Required when enabling IdP:
#   IDP_ISSUER        Base URL of the external IdP (e.g. https://keycloak.lgu.gov.ph)
#   IDP_CLIENT_ID     OAuth2 client ID registered with the IdP
#
# Optional:
#   IDP_CLIENT_SECRET OAuth2 client secret (omit for public clients)
#   IDP_SCOPES        Space-separated scopes (default: openid profile email)
#   LOCAL_LOGIN_ENABLED Set to "false" to hide the local username/password form
#                   when an external IdP is configured (default: true)
#
# The portal discovers the authorization, token, and userinfo endpoints from
# the IdP's .well-known/openid-configuration. The callback is fixed at
# /api/idp/callback and must be registered as a valid redirect URI in the IdP.
# IDP_ISSUER=
# IDP_CLIENT_ID=
# IDP_CLIENT_SECRET=
# IDP_SCOPES=
# LOCAL_LOGIN_ENABLED=
